    DEFINE WA MOLE-FLOW STREAM=7A SUBSTREAM=MIXED COMPONENT=H2O  &
        UOM="kmol/hr" 
    DEFINE STOC LOCAL-PARAM INIT-VAL=1.60 
C STEAM/CARBON MOLAR RATIO 
F     STOC = WA/(C1+2.0*C2+3.0*C3+4.0*C4) 
F 
