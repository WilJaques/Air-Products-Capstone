CONSTRAINT STOC 
    DEFINE C1 MOLE-FLOW STREAM=7A SUBSTREAM=MIXED COMPONENT=C1  &
        UOM="kmol/hr" 
    DEFINE C2 MOLE-FLOW STREAM=7A SUBSTREAM=MIXED COMPONENT=C2  &
