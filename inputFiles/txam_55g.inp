        "lbmol/hr" 
    LIMITS "50" "3000" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY STREAM-VAR STREAM=90X SUBSTREAM=MIXED VARIABLE=PRES  &
        UOM="psia" 
    LIMITS "5" "50" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=ARGCOL VARIABLE=D:F SENTENCE=COL-SPECS 
    LIMITS "0.0001" "0.1" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY MOLE-FLOW STREAM=90X SUBSTREAM=MIXED COMPONENT=N2 UOM= &
        "lbmol/hr" 
    LIMITS "1.0E-7" "1" STEP-SIZE=1E-007 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=LPCOL VARIABLE=MOLE-FLOW  &
        SENTENCE=PRODUCTS ID1=89 UOM="lbmol/hr" 
    LIMITS "250" "3000" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=LPCOL VARIABLE=MOLE-FLOW  &
        SENTENCE=PRODUCTS ID1=140 UOM="lbmol/hr" 
    LIMITS "50" "6000" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=LPCOL VARIABLE=PRES SENTENCE=P-SPEC  &
        ID1=1 UOM="psia" 
    LIMITS "15" "40" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY MOLE-FLOW STREAM=29X SUBSTREAM=MIXED COMPONENT=AR UOM= &
        "lbmol/hr" 
    LIMITS "1.0E-7" "30" STEP-SIZE=1E-007 MAX-STEP-SIZ=0.1 
    VARY MOLE-FLOW STREAM=29X SUBSTREAM=MIXED COMPONENT=N2 UOM= &
        "lbmol/hr" 
    LIMITS "500" "6000" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY MOLE-FLOW STREAM=29X SUBSTREAM=MIXED COMPONENT=O2 UOM= &
        "lbmol/hr" 
    LIMITS "1.0E-7" "0.1" STEP-SIZE=1E-007 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=SPLT350 SENTENCE=FRAC VARIABLE=FRAC  &
        ID1=80 
    LIMITS "0.0001" "0.9999" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=HX1 VARIABLE=TEMP SENTENCE=COLD-SIDE  &
        ID1=208 UOM="F" 
    LIMITS "-320" "-230" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY BLOCK-VAR BLOCK=HX1 VARIABLE=TEMP SENTENCE=COLD-SIDE  &
        ID1=140 UOM="F" 
    LIMITS "-320" "-230" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 
    VARY STREAM-VAR STREAM=GASAIRX SUBSTREAM=MIXED VARIABLE=TEMP  &
        UOM="K" 
    LIMITS "90" "150" STEP-SIZE=0.0001 MAX-STEP-SIZ=0.1 

CONV-OPTIONS 
    PARAM CHECKSEQ=YES 

CONVERGENCE OPTIMIZE SQP 
    BLOCK-OPTION CONV-LEVEL=6 TERM-LEVEL=3 
    OPTIMIZE OPTID=OBJ 
    PARAM MAXIT=75 TOL=0.0001 NLIMIT=30 CONST-ITER=150 

REPORT INPUT 

STREAM-REPOR MOLEFLOW MASSFLOW MOLEFRAC MASSFRAC PROPERTIES=TBUB 
