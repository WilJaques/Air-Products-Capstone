BLOCK EXPDR1 COMPR 
    PARAM TYPE=ISENTROPIC PRES=19.5 NPHASE=2 SB-MAXIT=30  &
        SB-TOL=1E-07 MODEL-TYPE=TURBINE 
    PERFOR-PARAM CALC-SPEED=NO 

BLOCK EXPDR2 COMPR 
    PARAM TYPE=ISENTROPIC PRES=83.7 NPHASE=2 SB-MAXIT=30  &
        SB-TOL=1E-07 MODEL-TYPE=TURBINE 
    PERFOR-PARAM CALC-SPEED=NO 

BLOCK BOOSTER MCOMPR 
    PARAM NSTAGE=4 TYPE=ISENTROPIC PRES=1603. COMPR-NPHASE=2  &
        SB-MAXIT=30 SB-TOL=1E-07 
    FEEDS 304 1 
    PRODUCTS 400 4 
    COOLER-SPECS 1 TEMP=87.5 / 2 TEMP=87.5 / 3 TEMP=87.5 /  &
        4 TEMP=87.5 

BLOCK COMP3 MCOMPR 
    PARAM NSTAGE=1 TYPE=ISENTROPIC PRES=170. COMPR-NPHASE=2  &
        SB-MAXIT=30 SB-TOL=1E-07 
    FEEDS 302 1 
    PRODUCTS 305 1 
    COOLER-SPECS 1 TEMP=100. 

BLOCK MAC MCOMPR 
    PARAM NSTAGE=4 TYPE=ISENTROPIC PRES=87. COMPR-NPHASE=2  &
        SB-MAXIT=30 SB-TOL=1E-07 
    FEEDS AIR 1 
    PRODUCTS 300 4 
    COOLER-SPECS 1 TEMP=100. / 2 TEMP=100. / 3 TEMP=100. /  &
        4 TEMP=100. 

BLOCK VALVE1 VALVE 
    PARAM P-DROP=0. 

EO-CONV-OPTI 

CALCULATOR INPUTS 
    DEFINE GANMOLEL PARAMETER 99 
    DEFINE GANMOLEU PARAMETER 100 
C Set GAN flow from plant bounds (lbmol/hr) 
F     GANMOLEL=3534.0 
F     GANMOLEU=1.07*3534.0 
F       
 
 
 
 
 
    WRITE-VARS GANMOLEL GANMOLEU 
    EXECUTE FIRST 

CONSTRAINT CL 
    DEFINE DHCOND BLOCK-VAR BLOCK=ARGCOL VARIABLE=COND-DUTY  &
        SENTENCE=RESULTS UOM="Btu/hr" 
    DEFINE Q BLOCK-VAR BLOCK=DRUM2 VARIABLE=DUTY SENTENCE=PARAM  &
        UOM="Btu/hr" 
    SPEC "DABS(DHCOND)/Q" GE "1.0" 
    TOL-SPEC "0.001" 

CONSTRAINT CU 
    DEFINE DHCOND BLOCK-VAR BLOCK=ARGCOL VARIABLE=COND-DUTY  &
        SENTENCE=RESULTS UOM="Btu/hr" 
    DEFINE Q BLOCK-VAR BLOCK=DRUM2 VARIABLE=DUTY SENTENCE=PARAM  &
        UOM="Btu/hr" 
    SPEC "DABS(DHCOND)/Q" LE "1.0" 
    TOL-SPEC "0.001" 

CONSTRAINT DTHX1 
    VECTOR-DEF DT PROFILE BLOCK=HX1 VARIABLE=DTBASE  &
        SENTENCE=BASE-PROFILE UOM="F" 
    PARAM VECTOR=YES 
    SPEC "DT" GE "0.25" 
    TOL-SPEC "0.001" 

CONSTRAINT DTHX2 
    VECTOR-DEF DT PROFILE BLOCK=HX2 VARIABLE=DTBASE  &
        SENTENCE=BASE-PROFILE UOM="F" 
    PARAM VECTOR=YES 
    SPEC "DT" GE "0.25" 
    TOL-SPEC "0.001" 

CONSTRAINT PURLAR 
    DEFINE YO160 MOLE-FRAC STREAM=160 SUBSTREAM=MIXED  &
        COMPONENT=O2 
    SPEC "YO160*100.0/2.0" EQ "1" 
    TOL-SPEC "0.001" 

CONSTRAINT RCDT 
    DEFINE TCOND STREAM-VAR STREAM=11 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="F" 
    DEFINE TREB STREAM-VAR STREAM=71 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="F" 
    SPEC "(TCOND-TREB)/1.27" GE "1.0" 
    TOL-SPEC "0.001" 

CONSTRAINT RCDT2 
    DEFINE TCOND STREAM-VAR STREAM=160 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="F" 
    DEFINE TREB STREAM-VAR STREAM=15 SUBSTREAM=MIXED  &
        VARIABLE=TEMP UOM="F" 
    DEFINE DT LOCAL-PARAM 
F     DT = TCOND-TREB 
F             
    SPEC "(TCOND-TREB)/3.88" GE "1.0" 
    TOL-SPEC "0.001" 

